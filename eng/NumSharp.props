<Project>
  <!-- ==================================================================================================================
       How Gym.NET builds against NumSharp, and NumSharp's ownership analyzer (NDW012/NDW016/NDW017).

       Every project that compiles against NumSharp (src/Gym, src/Gym.Environments, tests/Gym.Tests,
       tests/Gym.Tests.Parity) declares the regular NuGet reference itself, as its last lines, immediately followed by
       this import:

           <ItemGroup>
             <PackageReference Include="NumSharp" Version="..." />
           </ItemGroup>
           <Import Project="..\..\eng\NumSharp.props" />

       A project that also uses NumSharp.Interop.pythonnet (the live parity suite) declares that package in the same
       ItemGroup, at the same version; it follows the same switch (see the ItemGroup that captures it below).

       This file never adds a NumSharp PackageReference of its own. It only decides whether the declared one is used:

       NumSharpSource=Submodule (default): the declared package reference is removed and refs/NumSharp/src/NumSharp.Core is
         built from source instead. Required while Gym.NET depends on NumSharp master, because the DType API ("Stage B",
         NumSharp c916c579 and 68a02258) is in no published release. Against 0.70.0, the newest, the migrated code fails
         with four CS0121 (astype(Type, bool) vs astype(NPTypeCode, bool) for a DType argument, in Box) and one CS1061
         (Type has no kind, in Discrete.TryToInt64); measured, cf. docs/plans/NUMSHARP_MIGRATION_PLAN.md §3.2, whose
         trial code had one astype call fewer. Initialize the submodule
         NON-recursively; the exact command is in the GymNetRequireNumSharpSubmodule error below (an XML comment cannot
         spell its double-dash option). NumSharp's own submodules (numpy, pocketfft, OpenBLAS, onnxruntime, ...) are not
         needed to build NumSharp.Core, and a recursive init would clone all of them.
         The analyzer is referenced explicitly because a ProjectReference does not carry it: NumSharp.Core references it
         with PrivateAssets="all", so without the reference below a submodule build would silently skip the NDW
         diagnostics that package consumers get.
       NumSharpSource=Package: the declared package reference is used as it stands; the package ships the analyzer and the
         NDW013 guard itself. Make it the default only after raising the declared Version, in all three projects, to the
         first release that contains Stage B (plan §4.4).

       The import must come after the declared reference: an item Remove only sees items declared before it, and the
       packing guard must override the projects' own GeneratePackageOnBuild=true, which a property only does when it is
       evaluated later.

       Building NumSharp.Core from source also builds its IL weaver (tools/NumSharp.Build) and prints about 1,260
       NumSharp-internal warnings (mostly CS8632). They are NumSharp's, not Gym.NET's. Never pass -warnaserror on the
       command line: it would also apply to NumSharp's projects (plan §4.3).
       ================================================================================================================== -->
  <PropertyGroup>
    <NumSharpSource Condition="'$(NumSharpSource)' == ''">Submodule</NumSharpSource>
    <NumSharpRoot>$(MSBuildThisFileDirectory)..\refs\NumSharp\</NumSharpRoot>
  </PropertyGroup>

  <!-- The importing project's own NumSharp reference, captured before Submodule mode removes it, so that
       GymNetRequireDeclaredNumSharpPackage can report a project that forgot to declare it in either mode. -->
  <ItemGroup>
    <_GymNetDeclaredNumSharpPackage Include="@(PackageReference->WithMetadataValue('Identity', 'NumSharp'))" />
  </ItemGroup>

  <ItemGroup Condition="'$(NumSharpSource)' == 'Submodule'">
    <PackageReference Remove="NumSharp" />
    <ProjectReference Include="$(NumSharpRoot)src\NumSharp.Core\NumSharp.Core.csproj" />
  </ItemGroup>

  <!-- NumSharp.Interop.pythonnet, the NDArray <-> numpy bridge of the live parity suite (tests/Gym.Tests.Parity), is
       co-versioned with NumSharp and follows the same switch. A project that declares its package gets refs/NumSharp's
       source build of it in Submodule mode, compiled against the same NumSharp.Core. The package cannot be mixed with the
       submodule build: it is compiled against NuGet NumSharp 0.70.0, and NumSharp.Core packs under that same id and
       version, so NuGet would bind the package to the submodule's NumSharp.dll, whose DType API (Stage B) differs from
       the release; the mismatch would surface at run time as MissingMethodException, not at build time. Projects that
       don't declare the package are unaffected. -->
  <ItemGroup>
    <_GymNetDeclaredInteropPackage Include="@(PackageReference->WithMetadataValue('Identity', 'NumSharp.Interop.pythonnet'))" />
  </ItemGroup>

  <ItemGroup Condition="'$(NumSharpSource)' == 'Submodule' and '@(_GymNetDeclaredInteropPackage)' != ''">
    <PackageReference Remove="NumSharp.Interop.pythonnet" />
    <ProjectReference Include="$(NumSharpRoot)src\NumSharp.Interop.pythonnet\NumSharp.Interop.pythonnet.csproj" />
  </ItemGroup>

  <!-- ReferenceNDArrayAnalyzer=false drops the analyzer, mirroring the switch NumSharp.Core itself honours: a file-based
       app (dotnet run app.cs with #:project) forces its TargetFramework onto the whole ProjectReference graph during
       restore, so the netstandard2.0-only analyzer would restore for net8.0 and fail with NETSDK1005. Pass it as a
       global property (-p:ReferenceNDArrayAnalyzer=false) so NumSharp.Core drops its own analyzer reference too. -->
  <ItemGroup Condition="'$(NumSharpSource)' == 'Submodule' and '$(ReferenceNDArrayAnalyzer)' != 'false'">
    <ProjectReference Include="$(NumSharpRoot)tools\NumSharp.Build.Analyzer\NumSharp.Build.Analyzer.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <!-- Packing guard. In Submodule mode the ProjectReference to NumSharp.Core packs as a dependency on the NuGet package
       "NumSharp" at NumSharp master's VersionPrefix, 0.70.0: exactly the published version WITHOUT Stage B. Consumers of
       such a Gym.NET package would restore 0.70.0 and fail at run time with MissingMethodException/TypeLoadException.
       So a submodule build packs nothing on build, and an explicit pack fails loudly. NumSharpAllowSubmodulePack=true
       lifts both, for local experiments against a private NumSharp feed only. -->
  <PropertyGroup Condition="'$(NumSharpSource)' == 'Submodule' and '$(NumSharpAllowSubmodulePack)' != 'true'">
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <Target Name="GymNetBlockSubmodulePack" BeforeTargets="GenerateNuspec"
          Condition="'$(NumSharpSource)' == 'Submodule' and '$(NumSharpAllowSubmodulePack)' != 'true'">
    <Error Text="Gym.NET cannot be packed while NumSharpSource=Submodule: the package would depend on NuGet NumSharp 0.70.0, which lacks the DType API this build was compiled against. Pack with -p:NumSharpSource=Package once the declared NumSharp PackageReference names a release that contains Stage B, or pass -p:NumSharpAllowSubmodulePack=true for a local experiment." />
  </Target>

  <!-- Configuration guards. Each failure would otherwise surface as dozens of CS0246 errors that never name the cause. -->
  <Target Name="GymNetValidateNumSharpSource" BeforeTargets="CollectPackageReferences;ResolveProjectReferences"
          Condition="'$(NumSharpSource)' != 'Submodule' and '$(NumSharpSource)' != 'Package'">
    <Error Text="NumSharpSource must be 'Submodule' or 'Package', not '$(NumSharpSource)'." />
  </Target>

  <Target Name="GymNetRequireDeclaredNumSharpPackage" BeforeTargets="CollectPackageReferences;ResolveProjectReferences"
          Condition="'@(_GymNetDeclaredNumSharpPackage)' == ''">
    <Error Text="$(MSBuildProjectFile) imports eng/NumSharp.props but declares no NumSharp package reference. Declare &lt;PackageReference Include=&quot;NumSharp&quot; Version=&quot;...&quot; /&gt; in an ItemGroup right before the import: NumSharpSource=Package builds against it, and Submodule mode swaps it for refs/NumSharp." />
  </Target>

  <Target Name="GymNetRequireNumSharpSubmodule" BeforeTargets="CollectPackageReferences;ResolveProjectReferences"
          Condition="'$(NumSharpSource)' == 'Submodule' and !Exists('$(NumSharpRoot)src\NumSharp.Core\NumSharp.Core.csproj')">
    <Error Text="refs/NumSharp is missing. Run: git submodule update --init refs/NumSharp (not --recursive)." />
  </Target>
</Project>
