<Project>
  <!-- ==================================================================================================================
       Where Gym.NET gets NumSharp from, and NumSharp's ownership analyzer (NDW012/NDW016/NDW017).

       Imported at the END of every project that compiles against NumSharp or must be analyzed by NumSharp's ownership
       analyzer (src/Gym, src/Gym.Environments, tests/Gym.Tests). The end matters: the packing guard below overrides
       those projects' own GeneratePackageOnBuild=true, and a property only wins when it is evaluated after them.

       NumSharpSource=Submodule (default): builds refs/NumSharp/src/NumSharp.Core from source. Required while Gym.NET
         depends on NumSharp master, because the DType API ("Stage B", NumSharp c916c579 and 68a02258) is not in NuGet
         0.70.0; against that package the migrated code fails with three CS0121 and one CS1061
         (docs/plans/NUMSHARP_MIGRATION_PLAN.md §3.2). Initialize the submodule NON-recursively; the exact command is in
         the GymNetRequireNumSharpSubmodule error below (an XML comment cannot spell its double-dash option). NumSharp's
         own submodules (numpy, pocketfft, OpenBLAS, onnxruntime, ...) are not needed to build NumSharp.Core, and a
         recursive init would clone all of them.
         The analyzer is referenced explicitly because a ProjectReference does not carry it: NumSharp.Core references it
         with PrivateAssets="all", so without the reference below a submodule build would silently skip the NDW
         diagnostics that package consumers get.
       NumSharpSource=Package: consumes the published package, which ships the analyzer and the NDW013 guard itself.
         Flip only after setting NumSharpPackageVersion to the first release that contains Stage B (plan §4.4). The
         analyzer reference below needs no edit then: it is limited to Submodule mode, and the package ships its own.

       Building NumSharp.Core from source also builds its IL weaver (tools/NumSharp.Build) and prints about 1,260
       NumSharp-internal warnings (mostly CS8632). They are NumSharp's, not Gym.NET's. Never pass -warnaserror on the
       command line: it would also apply to NumSharp's projects (plan §4.3).
       ================================================================================================================== -->
  <PropertyGroup>
    <NumSharpSource Condition="'$(NumSharpSource)' == ''">Submodule</NumSharpSource>
    <NumSharpRoot>$(MSBuildThisFileDirectory)..\refs\NumSharp\</NumSharpRoot>
    <!-- Deliberately empty until a NumSharp release contains Stage B; the Package branch is unusable before that. -->
    <NumSharpPackageVersion></NumSharpPackageVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(NumSharpSource)' == 'Submodule'">
    <ProjectReference Include="$(NumSharpRoot)src\NumSharp.Core\NumSharp.Core.csproj" />
  </ItemGroup>

  <!-- ReferenceNDArrayAnalyzer=false drops the analyzer, mirroring the switch NumSharp.Core itself honours: a file-based
       app (dotnet run app.cs with #:project) forces its TargetFramework onto the whole ProjectReference graph during
       restore, so the netstandard2.0-only analyzer would restore for net8.0 and fail with NETSDK1005. Pass it as a
       global property (-p:ReferenceNDArrayAnalyzer=false) so NumSharp.Core drops its own analyzer reference too. -->
  <ItemGroup Condition="'$(NumSharpSource)' == 'Submodule' and '$(ReferenceNDArrayAnalyzer)' != 'false'">
    <ProjectReference Include="$(NumSharpRoot)tools\NumSharp.Build.Analyzer\NumSharp.Build.Analyzer.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup Condition="'$(NumSharpSource)' == 'Package'">
    <PackageReference Include="NumSharp" Version="$(NumSharpPackageVersion)" />
  </ItemGroup>

  <!-- Packing guard. In Submodule mode the ProjectReference to NumSharp.Core packs as a dependency on the NuGet package
       "NumSharp" at NumSharp master's VersionPrefix, 0.70.0: exactly the published version WITHOUT Stage B. Consumers of
       such a Gym.NET package would restore 0.70.0 and fail at run time with MissingMethodException/TypeLoadException.
       So a submodule build packs nothing on build, and an explicit pack fails loudly. NumSharpAllowSubmodulePack=true
       lifts both, for local experiments against a private NumSharp feed only. -->
  <PropertyGroup Condition="'$(NumSharpSource)' == 'Submodule' and '$(NumSharpAllowSubmodulePack)' != 'true'">
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <Target Name="GymNetBlockSubmodulePack" BeforeTargets="GenerateNuspec"
          Condition="'$(NumSharpSource)' == 'Submodule' and '$(NumSharpAllowSubmodulePack)' != 'true'">
    <Error Text="Gym.NET cannot be packed while NumSharpSource=Submodule: the package would depend on NuGet NumSharp 0.70.0, which lacks the DType API this build was compiled against. Pack with -p:NumSharpSource=Package -p:NumSharpPackageVersion=&lt;first release with Stage B&gt;, or pass -p:NumSharpAllowSubmodulePack=true for a local experiment." />
  </Target>

  <!-- Configuration guards. Each failure would otherwise surface as dozens of CS0246 errors (or a bare NuGet version
       error) that never name the cause. -->
  <Target Name="GymNetValidateNumSharpSource" BeforeTargets="CollectPackageReferences;ResolveProjectReferences"
          Condition="'$(NumSharpSource)' != 'Submodule' and '$(NumSharpSource)' != 'Package'">
    <Error Text="NumSharpSource must be 'Submodule' or 'Package', not '$(NumSharpSource)'." />
  </Target>

  <Target Name="GymNetRequireNumSharpPackageVersion" BeforeTargets="CollectPackageReferences;ResolveProjectReferences"
          Condition="'$(NumSharpSource)' == 'Package' and '$(NumSharpPackageVersion)' == ''">
    <Error Text="NumSharpSource=Package needs NumSharpPackageVersion set to the first NumSharp release that contains the DType API (Stage B); NuGet 0.70.0 does not." />
  </Target>

  <Target Name="GymNetRequireNumSharpSubmodule" BeforeTargets="CollectPackageReferences;ResolveProjectReferences"
          Condition="'$(NumSharpSource)' == 'Submodule' and !Exists('$(NumSharpRoot)src\NumSharp.Core\NumSharp.Core.csproj')">
    <Error Text="refs/NumSharp is missing. Run: git submodule update --init refs/NumSharp (not --recursive)." />
  </Target>
</Project>
