<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWpf>true</UseWpf>
    <IsPackable>false</IsPackable>
    <Company>SciSharp STACK</Company>
    <Authors>Eli Belash</Authors>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.1" />
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Gym.Environments\Gym.Environments.csproj" />
    <ProjectReference Include="..\..\src\Gym.Rendering.Avalonia\Gym.Rendering.Avalonia.csproj" />
    <ProjectReference Include="..\..\src\Gym.Rendering.WinForm\Gym.Rendering.WinForm.csproj" />
    <ProjectReference Include="..\..\src\Gym\Gym.csproj" />
  </ItemGroup>

  <!-- Gymnasium (9e04324, NumPy 2.4.2) golden of seeded space samples and CartPole resets, recorded by
       tools/parity/gymnasium_rng.py and replayed by GymnasiumRngParityTests. Embedded, so the test does not depend on the
       working directory or on copy-to-output. -->
  <ItemGroup>
    <EmbeddedResource Include="Parity\gymnasium_rng.golden.txt" LogicalName="Gym.Tests.Parity.gymnasium_rng.golden.txt" />
  </ItemGroup>

  <!-- NumSharp: the regular NuGet reference, declared here as well so the ownership analyzer also covers the tests (a
       package's analyzer does not flow to projects that reference it only through another project). While
       NumSharpSource=Submodule (the default until a NumSharp release contains the DType API), eng/NumSharp.props removes
       it and builds refs/NumSharp from source; -p:NumSharpSource=Package builds against it as it stands. -->
  <ItemGroup>
    <PackageReference Include="NumSharp" Version="0.70.0" />
  </ItemGroup>
  <Import Project="..\..\eng\NumSharp.props" />

</Project>
