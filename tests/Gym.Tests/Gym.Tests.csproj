<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWpf>true</UseWpf>
    <IsPackable>false</IsPackable>
    <Company>SciSharp STACK</Company>
    <Authors>Eli Belash</Authors>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.1" />
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Gym.Environments\Gym.Environments.csproj" />
    <ProjectReference Include="..\..\src\Gym.Rendering.Avalonia\Gym.Rendering.Avalonia.csproj" />
    <ProjectReference Include="..\..\src\Gym.Rendering.WinForm\Gym.Rendering.WinForm.csproj" />
    <ProjectReference Include="..\..\src\Gym\Gym.csproj" />
  </ItemGroup>

  <!-- Gymnasium (NumPy 2.4.2) golden of seeded space samples and CartPole resets, recorded by
       tools/parity/gymnasium_rng.py and replayed by GymnasiumRngParityTests. Recorded at 9e04324; re-recorded at v1.4.0
       on 2026-11-09, it came out byte-identical, so it stands for both. Embedded, so the test does not depend on the
       working directory or on copy-to-output. -->
  <ItemGroup>
    <EmbeddedResource Include="Parity\gymnasium_rng.golden.txt" LogicalName="Gym.Tests.Parity.gymnasium_rng.golden.txt" />
  </ItemGroup>

  <!-- The API inventory (port plan section 14.6, completion plan P0r.4): Gymnasium's public names as
       tools/parity/inventory.py scanned them, the pinned commit to check that scan against, and the ratchet list of names
       Gym.NET does not have yet. InventoryTests reads all three from the assembly, like the golden above. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\tools\parity\gymnasium_inventory.json" LogicalName="Gym.Tests.gymnasium_inventory.json" Link="Gymnasium\gymnasium_inventory.json" />
    <EmbeddedResource Include="..\..\tools\parity\manifest.json" LogicalName="Gym.Tests.parity_manifest.json" Link="Gymnasium\parity_manifest.json" />
    <EmbeddedResource Include="Gymnasium\inventory.expected-missing.txt" LogicalName="Gym.Tests.inventory.expected-missing.txt" />
  </ItemGroup>

  <!-- NumSharp: the regular NuGet reference, declared here as well so the ownership analyzer also covers the tests (a
       package's analyzer does not flow to projects that reference it only through another project). Used as it stands by
       default (NumSharpSource=Package); -p:NumSharpSource=Submodule makes eng/NumSharp.props swap it for refs/NumSharp's
       source build. -->
  <ItemGroup>
    <PackageReference Include="NumSharp" Version="0.80.0" />
  </ItemGroup>
  <Import Project="..\..\eng\NumSharp.props" />

</Project>
