<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWpf>true</UseWpf>
    <IsPackable>false</IsPackable>
    <Company>SciSharp STACK</Company>
    <Authors>Eli Belash</Authors>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.4.1" />
    <PackageReference Include="MSTest.TestFramework" Version="4.4.1" />
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Gym.Environments\Gym.Environments.csproj" />
    <ProjectReference Include="..\..\src\Gym.Rendering.Avalonia\Gym.Rendering.Avalonia.csproj" />
    <ProjectReference Include="..\..\src\Gym.Rendering.WinForm\Gym.Rendering.WinForm.csproj" />
    <ProjectReference Include="..\..\src\Gym\Gym.csproj" />
  </ItemGroup>

  <!-- NumPy 2.4.2 golden of the legacy RandomState draw patterns, recorded by tools/parity/legacy_rng.py and replayed by
       LegacyRngParityTests. Embedded, so the test does not depend on the working directory or on copy-to-output. -->
  <ItemGroup>
    <EmbeddedResource Include="Parity\legacy_rng.golden.txt" LogicalName="Gym.Tests.Parity.legacy_rng.golden.txt" />
  </ItemGroup>

  <!-- A direct NumSharp reference plus the ownership analyzer, so the NDW diagnostics also cover the tests; see
       eng/NumSharp.props. -->
  <Import Project="..\..\eng\NumSharp.props" />

</Project>
