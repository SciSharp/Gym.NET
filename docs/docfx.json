{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../src",
          "files": [
            "Gym/Gym.csproj",
            "Gym.Environments/Gym.Environments.csproj",
            "Gym.Rendering/Gym.Rendering.csproj",
            "Gym.Rendering.Avalonia/Gym.Rendering.Avalonia.csproj"
          ]
        }
      ],
      "dest": "website-src/api",
      "includePrivateMembers": false,
      "disableGitFeatures": false,
      "disableDefaultFilter": false,
      "noRestore": false,
      "namespaceLayout": "flattened",
      "memberLayout": "samePage",
      "enumSortOrder": "declaringOrder",
      "allowCompilationErrors": false,
      "properties": {
        "TargetFramework": "net10.0"
      }
    }
  ],
  "build": {
    "content": [
      {
        "src": "website-src",
        "files": ["**/*.{md,yml}"],
        "exclude": ["_site/**", "obj/**", "templates/**", "includes/**"],
        "dest": "."
      },
      {
        "files": ["README.md", "architecture.md", "guides/*.md", "releases/*.md", "environments/**/*.md", "environments/**/toc.yml"],
        "dest": "docs"
      }
    ],
    "resource": [
      {
        "src": "website-src",
        "files": ["images/**"],
        "dest": "."
      },
      {
        "files": ["media/*.mp4", "media/*.webp", "media/*.gif", "environments/**/media/*.mp4", "environments/**/media/*.png", "environments/**/media/*.json"],
        "dest": "docs"
      }
    ],
    "output": "website-src/_site",
    "template": ["default", "modern", "website-src/templates/gymnet"],
    "globalMetadata": {
      "_appName": "Gym.NET",
      "_appTitle": "Gym.NET",
      "_appLogoPath": "images/gymnet-logo.png",
      "_appFaviconPath": "images/gymnet-icon.png",
      "_appFooter": "<span>Copyright &copy; 2026 <a href='https://github.com/SciSharp'>SciSharp STACK</a>. Apache-2.0. Built with <a href='https://dotnet.github.io/docfx'>DocFX</a>.</span>",
      "_enableSearch": true,
      "_enableNewTab": true,
      "_disableContribution": false,
      "_disableNextArticle": false,
      "_lang": "en",
      "_gitContribute": {
        "repo": "https://github.com/SciSharp/Gym.NET",
        "branch": "master"
      }
    },
    "sitemap": {
      "baseUrl": "https://scisharp.github.io/Gym.NET",
      "changefreq": "weekly",
      "priority": 0.5
    },
    "xref": [],
    "xrefService": ["https://xref.docs.microsoft.com/query?uid={uid}"],
    "postProcessors": ["ExtractSearchIndex"]
  }
}
