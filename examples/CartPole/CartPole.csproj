<Project Sdk="Microsoft.NET.Sdk">

  <!-- Gym.NET's first example (decision D13): learns CartPole-v1 with the cross-entropy method over linear policies and
       plays the result, on the 1.0 API only; since DR-74 it also plays the showreel's hand-written controller and the
       keyboard. It references the source projects so it always builds against the current
       tree (Gym.NET.sln builds it, so an API change that breaks it fails the build); a copy outside this repository
       replaces the three ProjectReferences with PackageReferences to Gym.NET.Environments and
       Gym.NET.Rendering.Avalonia, and drops the Import below (the package brings it). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Gym.Examples.CartPole</RootNamespace>
    <AssemblyName>CartPole</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Gym\Gym.csproj" />
    <ProjectReference Include="..\..\src\Gym.Environments\Gym.Environments.csproj" />
    <ProjectReference Include="..\..\src\Gym.Rendering.Avalonia\Gym.Rendering.Avalonia.csproj" />
  </ItemGroup>

  <!-- NumSharp.Build weaves [NDScoped] (DR-80): the episode and evaluation methods release every array they create when
       they return, the way the guides release what an env returns. A build-time package only, kept out of the output. -->
  <ItemGroup>
    <PackageReference Include="NumSharp.Build" Version="0.81.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- What the Gym.NET.Environments package's buildTransitive targets do for a C# app (DR-17): compile a module
       initializer that registers the built-in env ids before Main, so Gymnasium.Make("CartPole-v1") works with no set-up
       call. A ProjectReference does not bring buildTransitive files, so the example imports it by path, as the tests do. -->
  <Import Project="..\..\src\Gym.Environments\buildTransitive\Gym.NET.Environments.targets" />

</Project>
