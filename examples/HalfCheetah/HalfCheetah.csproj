<Project Sdk="Microsoft.NET.Sdk">

  <!-- HalfCheetah-v5 (decision DR-74): one seeded episode played by Farama's TQC expert (DR-109) or on its autopilot,
       headless or in MuJoCo's window, through Gymnasium.Make; and the playable HalfCheetah, which moved here from tools/parity/mujoco/halfcheetah_poc/play: Gym.NET's
       MuJoCo engine (compiled in from src/Gym.Environments/MuJoCo) in a Gym.NET viewer window, keyboard-driven or on the
       autopilot, which Augmented Random Search trained on the same engine. Gym.NET.sln builds it, so an API change that
       breaks it fails the build. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <RootNamespace>MujocoPoc.Play</RootNamespace>
    <AssemblyName>HalfCheetah</AssemblyName>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- Gym.Environments' assembly holds the same Gym.MuJoCo types this project compiles from source (below) to reach the
         engine's internals; the compiled-in copy wins, as intended (CS0436). The episode modes go through
         Gymnasium.Make and touch no MuJoCo type, so the two copies never meet. -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <!-- The engine is the product's own source, the one the trace checker proves bit-exact; it is compiled in, not copied. -->
  <ItemGroup>
    <Compile Include="..\..\src\Gym.Environments\MuJoCo\*.cs" Link="Engine\%(Filename)%(Extension)" />
    <ProjectReference Include="..\..\src\Gym\Gym.csproj" />
    <ProjectReference Include="..\..\src\Gym.Environments\Gym.Environments.csproj" />
  </ItemGroup>

  <!-- MuJoCo's compiled HalfCheetah (the embedded model of DR-63), the trained autopilot, and Farama's TQC expert (a copy
       of tests/Gym.Tests/Agents/HalfCheetah-v5.json, DR-109), next to the program. -->
  <ItemGroup>
    <None Include="..\..\src\Gym.Environments\Assets\mujoco\half_cheetah.json" Link="half_cheetah.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="policy.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('policy.json')" />
    <None Include="expert.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Gym.NET's pygame-compatible rasterizer draws the game's frames; its Avalonia viewer shows them and reports the keys. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Gym.Rendering\Gym.Rendering.csproj" />
    <ProjectReference Include="..\..\src\Gym.Rendering.Avalonia\Gym.Rendering.Avalonia.csproj" />
  </ItemGroup>

  <!-- Used directly: ImageSharp carries frames to the viewer, NumSharp draws Gymnasium's reset noise. -->
  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
    <PackageReference Include="NumSharp" Version="0.81.0" />
  </ItemGroup>

  <!-- NumSharp.Build weaves [NDScoped] (DR-80): the episode methods release every array the episode creates
       when it returns, the way the guides release what an env returns. A build-time package only, kept out of the output. -->
  <ItemGroup>
    <PackageReference Include="NumSharp.Build" Version="0.81.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- What the Gym.NET.Environments package's buildTransitive targets do for a C# app (DR-17): register the built-in env
       ids before Main, so Gymnasium.Make("HalfCheetah-v5") works with no set-up call. -->
  <Import Project="..\..\src\Gym.Environments\buildTransitive\Gym.NET.Environments.targets" />

</Project>
