<Project Sdk="Microsoft.NET.Sdk">

  <!-- The proof of concept for HalfCheetah-v5, Hopper-v5 and Humanoid-v5: one from-scratch managed core specialized to
       their models, checked bit for bit against MuJoCo 3.15.0 traces recorded by oracle.py (the folder keeps
       HalfCheetah's name, its first env). Not part of Gym.NET.sln; nothing ships from here. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MujocoPoc</RootNamespace>
  </PropertyGroup>

  <!-- play/ is a project of its own (the playable window), compiled separately. -->
  <ItemGroup>
    <Compile Remove="play\**" />
  </ItemGroup>

  <!-- NumSharp's Generator is NumPy's bit for bit: it draws the reset noise and the sampled actions Gymnasium draws. -->
  <ItemGroup>
    <PackageReference Include="NumSharp" Version="0.80.0" />
  </ItemGroup>

</Project>
