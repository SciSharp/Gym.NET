<Project Sdk="Microsoft.NET.Sdk">

  <!-- The trace checker of Gym.NET's MuJoCo engine (the 21 ids that run on MuJoCo 3 and 4): it compiles the engine's own
       sources from src/Gym.Environments/MuJoCo (DR-61) and checks them bit for bit against MuJoCo 4.0.0 traces recorded
       by oracle.py. The folder keeps the proof of concept's name, HalfCheetah being its first env. Not part of
       Gym.NET.sln; nothing ships from here. verify/ holds the scripts that measure how far the traces reach (coverage,
       the branch search, the negative controls, the speed). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MujocoPoc</RootNamespace>
    <!-- The repository's root, and where the engine's sources come from: the product's folder by default. verify/'s branch
         search and negative controls build a patched copy elsewhere, passing both (-p:GymRoot=... -p:MuJoCoSource=...). -->
    <GymRoot Condition="'$(GymRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\..\</GymRoot>
    <MuJoCoSource Condition="'$(MuJoCoSource)' == ''">$(GymRoot)src\Gym.Environments\MuJoCo</MuJoCoSource>
  </PropertyGroup>

  <!-- play/ is a project of its own (the playable window), compiled separately. -->
  <ItemGroup>
    <Compile Remove="play\**" />
  </ItemGroup>

  <!-- The engine itself, compiled from its single source, so the checker proves the code that ships. Its internal members
       (MuJoCo's names, the step and its stages) are visible to the checker because they compile into this assembly. -->
  <ItemGroup>
    <Compile Include="$(MuJoCoSource)\*.cs" Link="Engine\%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Gym, for the engine's public surface ([PyName], Python's exceptions through NumSharp, PyBuiltins). -->
  <ItemGroup>
    <ProjectReference Include="$(GymRoot)src\Gym\Gym.csproj" />
  </ItemGroup>

  <!-- NumSharp's Generator is NumPy's bit for bit: it draws the reset noise and the sampled actions Gymnasium draws. -->
  <ItemGroup>
    <PackageReference Include="NumSharp" Version="0.81.0" />
  </ItemGroup>

</Project>
