<Project Sdk="Microsoft.NET.Sdk">

  <!-- The HalfCheetah-v5 proof of concept: a from-scratch managed core specialized to the model's structure, checked bit
       for bit against MuJoCo 3.15.0 traces recorded by oracle.py. Not part of Gym.NET.sln; nothing ships from here. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MujocoPoc</RootNamespace>
  </PropertyGroup>

  <!-- NumSharp's Generator is NumPy's bit for bit: it draws the reset noise and the sampled actions Gymnasium draws. -->
  <ItemGroup>
    <PackageReference Include="NumSharp" Version="0.80.0" />
  </ItemGroup>

</Project>
