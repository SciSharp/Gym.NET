<Project Sdk="Microsoft.NET.Sdk">

  <!-- The proof of concept for Gymnasium's MuJoCo envs (the 21 ids that run on MuJoCo 3): one from-scratch managed core
       specialized to their models, checked bit for bit against MuJoCo 3.15.0 traces recorded by oracle.py (the folder
       keeps HalfCheetah's name, its first env). Not part of Gym.NET.sln; nothing ships from here. verify/ holds the
       scripts that measure how far the traces reach (coverage, the branch search, the negative controls, the speed). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MujocoPoc</RootNamespace>
  </PropertyGroup>

  <!-- play/ is a project of its own (the playable window), compiled separately. -->
  <ItemGroup>
    <Compile Remove="play\**" />
  </ItemGroup>

  <!-- NumSharp's Generator is NumPy's bit for bit: it draws the reset noise and the sampled actions Gymnasium draws. -->
  <ItemGroup>
    <PackageReference Include="NumSharp" Version="0.80.0" />
  </ItemGroup>

</Project>
