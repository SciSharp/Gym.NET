<Project Sdk="Microsoft.NET.Sdk">

  <!-- HalfCheetah-v5 to play: Gym.NET's MuJoCo engine (compiled in from src/Gym.Environments/MuJoCo) in a Gym.NET viewer
       window, keyboard-driven or on an autopilot trained by Augmented Random Search on the same engine. Not part of
       Gym.NET.sln; nothing ships from here. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MujocoPoc.Play</RootNamespace>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- The Avalonia viewer brings Gym.Environments, whose assembly holds the same Gym.MuJoCo types this project compiles
         from source (below) to reach the engine's internals; the compiled-in copy wins, as intended (CS0436). -->
    <NoWarn>$(NoWarn);CS0436</NoWarn>
  </PropertyGroup>

  <!-- The engine is the product's own source, the one the trace checker proves bit-exact; it is compiled in, not copied. -->
  <ItemGroup>
    <Compile Include="..\..\..\..\..\src\Gym.Environments\MuJoCo\*.cs" Link="Engine\%(Filename)%(Extension)" />
    <ProjectReference Include="..\..\..\..\..\src\Gym\Gym.csproj" />
  </ItemGroup>

  <!-- MuJoCo's compiled HalfCheetah (the embedded model of DR-63) and the trained autopilot, next to the program. -->
  <ItemGroup>
    <None Include="..\..\..\..\..\src\Gym.Environments\Assets\mujoco\half_cheetah.json" Link="half_cheetah.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="policy.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('policy.json')" />
  </ItemGroup>

  <!-- Gym.NET's pygame-compatible rasterizer draws the frames; its Avalonia viewer shows them and reports the keys. -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\..\src\Gym.Rendering\Gym.Rendering.csproj" />
    <ProjectReference Include="..\..\..\..\..\src\Gym.Rendering.Avalonia\Gym.Rendering.Avalonia.csproj" />
  </ItemGroup>

  <!-- Used directly: ImageSharp carries frames to the viewer, NumSharp draws Gymnasium's reset noise. -->
  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
    <PackageReference Include="NumSharp" Version="0.80.0" />
  </ItemGroup>

</Project>
