<Project Sdk="Microsoft.NET.Sdk">

  <!-- The front-page showreel: plays every visually distinct built-in env under a scripted policy, composes the
       synthwave video (docs/media/gym-net-showreel.mp4), the README's GIF loop (docs/media/gym-net-hero.gif) and the
       docs site's cartridge gallery (docs/website-src/images/envs), and proves its parity segment against Gymnasium
       running in Python. Not part of Gym.NET.sln; nothing ships from here. README.md has the commands. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Gym.Showreel</RootNamespace>
    <AssemblyName>Showreel</AssemblyName>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- The compositor's inner loops index spans by hand; AllowUnsafeBlocks is not needed, bounds checks stay on. -->
  </PropertyGroup>

  <!-- The envs and their heuristics; Gym.Box2D is referenced directly because CarRacing's driver reads the hull's
       b2Body (Gym.Environments references Gym.Box2D privately, so its types do not flow to this project). -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Gym\Gym.csproj" />
    <ProjectReference Include="..\..\src\Gym.Environments\Gym.Environments.csproj" />
    <ProjectReference Include="..\..\src\Gym.Box2D\Gym.Box2D.csproj" />
  </ItemGroup>

  <!-- The Python half of the parity segment, run as a separate process, sits next to the program. -->
  <ItemGroup>
    <None Include="gymnasium_replay.py" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- What the Gym.NET.Environments package's buildTransitive targets do for a C# app (DR-17): register the built-in
       env ids before Main. A ProjectReference does not bring buildTransitive files, so it is imported by path, as the
       example does. -->
  <Import Project="..\..\src\Gym.Environments\buildTransitive\Gym.NET.Environments.targets" />

  <!-- Used directly: ImageSharp writes the PNG stills and posters, NumSharp builds the policies' actions. NumSharp is
       declared last and followed by eng/NumSharp.props, as in every project that compiles against it, so the
       -p:NumSharpSource=Submodule switch reaches this tool too. -->
  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
    <PackageReference Include="NumSharp" Version="0.80.0" />
  </ItemGroup>
  <Import Project="..\..\eng\NumSharp.props" />

</Project>
