<Project Sdk="Microsoft.NET.Sdk">

  <!-- The front-page showreel: plays every visually distinct built-in env under a scripted policy or a published expert
       agent, composes the video (docs/media/gym-net-showreel.mp4), the README's animation, its cut as animated WebP
       (docs/media/gym-net-hero.webp), and the docs site's cartridge gallery (docs/website-src/images/envs), and proves
       its parity segment against Gymnasium running in Python. Not part of Gym.NET.sln; nothing ships from here.
       README.md has the commands. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Gym.Showreel</RootNamespace>
    <AssemblyName>Showreel</AssemblyName>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <!-- The compositor's inner loops index spans by hand; AllowUnsafeBlocks is not needed, bounds checks stay on. -->
  </PropertyGroup>

  <!-- The envs and their heuristics. CarRacing's driver reads the hull's b2Body, a Gym.Box2D type that Gym.Environments
       compiles itself (DR-65), so this one reference brings it. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Gym\Gym.csproj" />
    <ProjectReference Include="..\..\src\Gym.Environments\Gym.Environments.csproj" />
  </ItemGroup>

  <!-- The Python half of the parity segment, run as a separate process, and the ARS policies the train command writes
       sit next to the program. -->
  <ItemGroup>
    <None Include="gymnasium_replay.py" CopyToOutputDirectory="PreserveNewest" />
    <None Include="policies\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The expert agents the MuJoCo envs and the hardcore walker play (DR-103), and their reader, taken from their home
       in the unit tests, so the showreel plays exactly the agents the tests measure: agents\<id>.json next to the
       program. -->
  <ItemGroup>
    <Compile Include="..\..\tests\Gym.Tests\Agents\ExpertPolicy.cs" Link="Agents\ExpertPolicy.cs" />
    <None Include="..\..\tests\Gym.Tests\Agents\*.json" Link="agents\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- What the Gym.NET.Environments package's buildTransitive targets do for a C# app (DR-17): register the built-in
       env ids before Main. A ProjectReference does not bring buildTransitive files, so it is imported by path, as the
       example does. -->
  <Import Project="..\..\src\Gym.Environments\buildTransitive\Gym.NET.Environments.targets" />

  <!-- Used directly: ImageSharp writes the PNG stills and posters, NumSharp builds the policies' actions. NumSharp is
       declared last and followed by eng/NumSharp.props, as in every project that compiles against it, so the
       -p:NumSharpSource=Submodule switch reaches this tool too. -->
  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
    <PackageReference Include="NumSharp" Version="0.81.0" />
  </ItemGroup>
  <Import Project="..\..\eng\NumSharp.props" />

</Project>
