<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageId>Gym.NET.Rendering.WinForm</PackageId>
    <Version>1.0.0</Version>
    <Authors>Eli Belash</Authors>
    <Company>SciSharp STACK</Company>
    <Product>Gym.NET.Rendering.WinForm</Product>
    <Description>A Windows Forms window for Gym.NET's human render mode (Windows only): set Gymnasium.HumanViewerFactory = WinFormEnvViewer.Factory and make an env with render_mode "human". Also PlayPlot's live charts drawn by ScottPlot (WinFormPlotFigure.Subplots()).</Description>
    <Copyright>2019-2026 © SciSharp STACK Team</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/SciSharp/Gym.NET</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/SciSharp/Gym.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>gym;gymnasium;reinforcement-learning;rendering;winforms;viewer</PackageTags>
    <PackageReleaseNotes>https://github.com/SciSharp/Gym.NET/blob/master/docs/releases/RELEASE_1.0.0.md</PackageReleaseNotes>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <!-- The XML documentation goes into the package next to the assembly, so consumers' IntelliSense shows Gym.NET's docs
         (P10.4). Members of the pre-1.0 code without docs (Gym.Internal, the 0.2 LunarLander, the viewers' XAML classes)
         raise CS1591 warnings, which the build tolerates (DR-05). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gym.Environments\Gym.Environments.csproj" />
    <ProjectReference Include="..\Gym\Gym.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- PlayPlot's chart backend in this package (DR-39): ScottPlot's Windows Forms control (MIT). The core package stays
         free of chart dependencies. -->
    <PackageReference Include="ScottPlot.WinForms" Version="5.1.59" />
  </ItemGroup>

  <ItemGroup>
    <!-- The ScottPlot axes adapter both viewer packages compile, so their figures draw alike (DR-39). -->
    <Compile Include="..\Shared\ScottPlotAxes.cs" Link="Plotting\ScottPlotAxes.cs" />
  </ItemGroup>

  <!-- The package's icon and readme, packed at its root (NuGet's PackageIcon / PackageReadmeFile). They replace the
       deprecated PackageIconUrl / PackageLicenseUrl, which fail packing as NU5048 / NU5125 where warnings are errors.
       THIRD-PARTY-NOTICES.md goes with them: the packages carry code and data from other projects (Gymnasium's assets,
       Box2D, SDL_gfx, SDL_ttf, CPython, OpenCV, pygame-ce, MuJoCo; each listed there with its notice), and those
       licences ask for their notices in every copy. One file in all five packages, so none ships without a notice it
       needs; the package's own licence stays the Apache-2.0 expression (DR-49). -->
  <ItemGroup>
    <None Include="..\..\eng\icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>
