<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <!-- net11.0 (D24) when the SDK can build it, 11.0.100 and later: an older SDK keeps building the frameworks above
         instead of failing with NETSDK1045, and Directory.Build.targets stops a release build on one. -->
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">$(TargetFrameworks);net11.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <!-- Nullable reference types for every file, not only those that opt in (DR-54); warnings stay warnings (DR-05). -->
    <Nullable>enable</Nullable>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageId>Gym.NET.Environments</PackageId>
    <!-- Release candidate 1 of 1.0 (decision D25). NuGet ignores the +rc1 build metadata when it matches versions,
         so this is the stable 1.0.0 to every client; the label stays in the package's version and the assemblies'
         informational version. The next release, a fix or the final, is 1.0.1: nuget.org cannot hold a second 1.0.0. -->
    <Version>1.0.0+rc1</Version>
    <Authors>Eli Belash</Authors>
    <Company>SciSharp STACK</Company>
    <Product>Gym.NET.Environments</Product>
    <Description>Gym.NET's environments, registered for Gymnasium.Make: classic_control (CartPole, MountainCar, MountainCarContinuous, Pendulum, Acrobot), box2d (LunarLander, LunarLanderContinuous, BipedalWalker, BipedalWalkerHardcore, CarRacing, on Box2D 2.3 in managed C#) and toy_text (FrozenLake, CliffWalking, Taxi, Blackjack), each equal to Gymnasium's step for step and frame for frame; mujoco (Ant, HalfCheetah, Hopper, Humanoid, HumanoidStandup, InvertedPendulum, InvertedDoublePendulum, Pusher, Reacher, Swimmer, Walker2d, each v4 and v5) on Gym.NET's own engine, equal to Gymnasium's on MuJoCo 4.0.0 step for step, their frames drawn by Gym.NET and measured against Gymnasium's; and CartPole's vector env for Gymnasium.MakeVec.</Description>
    <Copyright>2019-2026 © SciSharp STACK Team</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/SciSharp/Gym.NET</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <!-- No PackageReadmeFile, deliberately: Directory.Build.targets (GYMNET0012) says why and enforces it. -->
    <RepositoryUrl>https://github.com/SciSharp/Gym.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>gym;gymnasium;reinforcement-learning;rl;environments;cartpole;mountaincar;pendulum;acrobot;lunarlander;bipedalwalker;carracing;box2d;frozenlake;taxi;blackjack;mujoco;halfcheetah;hopper;humanoid;ant;walker2d</PackageTags>
    <PackageReleaseNotes>https://github.com/SciSharp/Gym.NET/blob/master/docs/releases/RELEASE_1.0.0.md</PackageReleaseNotes>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <!-- The XML documentation goes into the package next to the assembly, so consumers' IntelliSense shows Gym.NET's docs
         (P10.4). Members of the pre-1.0 code without docs (Gym.Internal, the viewers' XAML classes) raise CS1591 warnings,
         which the build tolerates (DR-05). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
  </PropertyGroup>

  <!-- The test suites reach CarRacing's internal score text directly: ScoreFont (its embedded glyph data and layout,
       compared with pygame's own renders and a live recording) and CarRacingEnv.FormatScore (Python's format). -->
  <ItemGroup>
    <InternalsVisibleTo Include="Gym.Tests" />
    <InternalsVisibleTo Include="Gym.Tests.Parity" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Gym.csproj.DotSettings" />
    <None Remove="Gym.Environments.csproj.DotSettings" />
    <None Remove="Gymg.csproj.DotSettings" />
  </ItemGroup>

  <ItemGroup>
    <!-- SixLabors stays on its last Apache-2.0 release (ImageSharp 2.1.x). Newer majors ship under the Six Labors Split
         License and fail Release builds without a Six Labors license key. The human window hands the viewers ImageSharp
         images. (Aether.Physics2D, ImageSharp.Drawing and SixLabors.Fonts went with the 0.2 LunarLander in P8.5.) -->
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gym\Gym.csproj" />
    <!-- The pygame-compatible rasterizer the classic-control envs render rgb_array frames with, pixel for pixel. -->
    <ProjectReference Include="..\Gym.Rendering\Gym.Rendering.csproj" />
    <!-- The source generator, for the envs' [GymOptions] records (DR-34): compiler-only, not a runtime dependency. -->
    <ProjectReference Include="..\Gym.SourceGenerators\Gym.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
  </ItemGroup>

  <!-- The managed Box2D engine of the box2d envs (D5, DR-26) is part of this assembly (DR-65): Box2D/ holds Box2D 2.3.0
       in managed C# under its own namespace, Gym.Box2D, compiled here as any other folder, so the envs' public API that
       returns its types (LunarLanderEnv.World, CarRacingEnv's car) needs no second assembly and no packing step. Its
       files keep Erin Catto's and Ken Lauer's zlib notices (THIRD-PARTY-NOTICES.md). Until DR-65 it was a project of its
       own built with warnings as errors; here the project's rule applies (DR-05). -->


  <!-- The envs' images (DR-19): copied once from the pinned Gymnasium (Assets/README.md lists sources and hashes) and
       embedded, so the package carries them. Each is named assets/<path> with forward slashes on every OS (RecursiveDir
       uses the OS separator), which is the name EnvAssets.Load asks for. CarRacing's score glyphs (DR-48) are recorded
       data, Assets/fonts/*.json, embedded under the same naming for ScoreFont; so are Gymnasium's 14 MuJoCo models as
       MuJoCo 4.0.0 compiles them (DR-63, DR-64), Assets/mujoco/*.json with their textures, for MjModel.FromXmlPath. -->
  <ItemGroup>
    <EmbeddedResource Include="Assets\**\*.png" LogicalName="assets/$([System.String]::Copy('%(RecursiveDir)').Replace('\','/'))%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\**\*.json" LogicalName="assets/$([System.String]::Copy('%(RecursiveDir)').Replace('\','/'))%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- The package's icon, packed at its root (NuGet's PackageIcon), replaces the deprecated PackageIconUrl, as
       PackageLicenseExpression replaces PackageLicenseUrl: both deprecated properties fail packing as NU5048 / NU5125 where
       warnings are errors. No readme is packed (Directory.Build.targets, GYMNET0012).
       THIRD-PARTY-NOTICES.md goes with the icon: the packages carry code and data from other projects (Gymnasium's assets,
       Box2D, SDL_gfx, SDL_ttf, CPython, OpenCV, pygame-ce, MuJoCo; each listed there with its notice), and those
       licences ask for their notices in every copy. One file in all five packages, so none ships without a notice it
       needs; the package's own licence stays the Apache-2.0 expression (DR-49). -->
  <ItemGroup>
    <None Include="..\..\eng\icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- DR-17's app-side registration: buildTransitive/Gym.NET.Environments.targets compiles GymNetEnvironmentsRegistration.cs
       into every C# project consuming the package, so the built-in ids register before Main. The .cs file is the consumer's,
       not this library's: it is removed from this project's own compile (the SDK would glob it in) and packed beside the
       targets. -->
  <ItemGroup>
    <Compile Remove="buildTransitive\**" />
    <None Include="buildTransitive\Gym.NET.Environments.targets" Pack="true" PackagePath="buildTransitive\" />
    <None Include="buildTransitive\GymNetEnvironmentsRegistration.cs" Pack="true" PackagePath="buildTransitive\" />
  </ItemGroup>
  <!-- NumSharp.Build, the [NDScoped] IL weaver of decision D19: after compile it wraps each [NDScoped] method's body in an
       NDScope, so a method's temporary arrays are reclaimed while its results (and the INDArrayCarrier results,
       StepResult/ResetResult) survive. A development dependency: PrivateAssets="all" keeps it out of the package's
       dependencies, and it rewrites only this assembly. -p:SkipNDScopeWeave=true builds without weaving. -->
  <ItemGroup>
    <PackageReference Include="NumSharp.Build" Version="0.81.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- NumSharp: the regular NuGet reference, used as it stands by default (NumSharpSource=Package; 0.80.0 is the first
       release with the DType API). -p:NumSharpSource=Submodule makes eng/NumSharp.props swap it for refs/NumSharp's source
       build, with its ownership analyzer, to try a NumSharp fix before NumSharp releases it. The import stays last: it
       removes the reference declared before it and overrides GeneratePackageOnBuild above. -->
  <ItemGroup>
    <PackageReference Include="NumSharp" Version="0.81.0" />
  </ItemGroup>
  <Import Project="..\..\eng\NumSharp.props" />

</Project>
