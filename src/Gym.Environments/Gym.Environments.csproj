<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageId>Gym.NET.Environments</PackageId>
    <Version>0.2.0</Version>
    <Authors>Eli Belash</Authors>
    <Company>SciSharp STACK</Company>
    <Product>Gym.NET.Environments</Product>
    <Description>openai/gym's popular toolkit for developing and comparing reinforcement learning algorithms port to C#.  This package contains ported gym's environments.</Description>
    <Copyright>2023 © SciSharp STACK Team</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/SciSharp/Gym.NET</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/SciSharp/Gym.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>gym, openai, reinforcement learning,learning,learning,NumPy, NumSharp, MachineLearning</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <AssemblyVersion>0.1.0.2</AssemblyVersion>
    <FileVersion>0.1.0.2</FileVersion>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Gym.csproj.DotSettings" />
    <None Remove="Gym.Environments.csproj.DotSettings" />
    <None Remove="Gymg.csproj.DotSettings" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aether.Physics2D" Version="1.6.1" />
    <!-- SixLabors stays on its last Apache-2.0 releases (ImageSharp 2.1.x, Drawing 1.0.x, Fonts 1.0.x). Newer majors ship
         under the Six Labors Split License and fail Release builds without a Six Labors license key. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="1.0.0" />
    <PackageReference Include="SixLabors.Fonts" Version="1.0.1" />
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gym\Gym.csproj" />
    <!-- The pygame-compatible rasterizer the classic-control envs render rgb_array frames with, pixel for pixel. -->
    <ProjectReference Include="..\Gym.Rendering\Gym.Rendering.csproj" />
  </ItemGroup>

  <!-- The package's icon and readme, packed at its root (NuGet's PackageIcon / PackageReadmeFile). They replace the
       deprecated PackageIconUrl / PackageLicenseUrl, which fail packing as NU5048 / NU5125 where warnings are errors. -->
  <ItemGroup>
    <None Include="..\..\eng\icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
  <!-- NumSharp.Build, the [NDScoped] IL weaver of decision D19: after compile it wraps each [NDScoped] method's body in an
       NDScope, so a method's temporary arrays are reclaimed while its results (and the INDArrayCarrier results,
       StepResult/ResetResult) survive. A development dependency: PrivateAssets="all" keeps it out of the package's
       dependencies, and it rewrites only this assembly. -p:SkipNDScopeWeave=true builds without weaving. -->
  <ItemGroup>
    <PackageReference Include="NumSharp.Build" Version="0.80.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- NumSharp: the regular NuGet reference, used as it stands by default (NumSharpSource=Package; 0.80.0 is the first
       release with the DType API). -p:NumSharpSource=Submodule makes eng/NumSharp.props swap it for refs/NumSharp's source
       build, with its ownership analyzer, to try a NumSharp fix before NumSharp releases it. The import stays last: it
       removes the reference declared before it and overrides GeneratePackageOnBuild above. -->
  <ItemGroup>
    <PackageReference Include="NumSharp" Version="0.80.0" />
  </ItemGroup>
  <Import Project="..\..\eng\NumSharp.props" />

</Project>
