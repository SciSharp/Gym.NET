<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <!-- net11.0 (D24) when the SDK can build it, 11.0.100 and later: an older SDK keeps building the frameworks above
         instead of failing with NETSDK1045, and Directory.Build.targets stops a release build on one. -->
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">$(TargetFrameworks);net11.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <!-- Nullable reference types for every file, not only those that opt in (DR-54); warnings stay warnings (DR-05). -->
    <Nullable>enable</Nullable>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageId>Gym.NET</PackageId>
    <Version>1.0.0</Version>
    <Authors>Eli Belash</Authors>
    <Company>SciSharp STACK</Company>
    <Product>Gym.NET</Product>
    <Description>Reinforcement-learning environments for .NET with Gymnasium's API and behavior: Env&lt;TObs, TAct&gt;, wrappers, the ten spaces, the registry with Gymnasium.Make and Gymnasium.MakeVec, vector envs and the env checkers. Seeded runs reproduce Gymnasium's random streams, observations and rewards bit for bit. The pre-0.26 API stays available, obsolete, in Gym.Legacy.</Description>
    <Copyright>2019-2026 © SciSharp STACK Team</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/SciSharp/Gym.NET</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/SciSharp/Gym.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>gym;gymnasium;reinforcement-learning;rl;environments;numsharp;numpy;machine-learning</PackageTags>
    <PackageReleaseNotes>https://github.com/SciSharp/Gym.NET/blob/master/docs/releases/RELEASE_1.0.0.md</PackageReleaseNotes>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <!-- The XML documentation goes into the package next to the assembly, so consumers' IntelliSense shows Gym.NET's docs
         (P10.4). Members of the pre-1.0 code without docs (Gym.Internal, the 0.2 LunarLander, the viewers' XAML classes)
         raise CS1591 warnings, which the build tolerates (DR-05). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>
  <ItemGroup>
    <!-- ImageSharp stays on its last Apache-2.0 release line (2.1.x): newer majors ship under the Six Labors Split
         License and fail Release builds without a Six Labors license key. Its 2026-10-07 advisories are suppressed in
         Directory.Build.props (D18). src/Gym needs ImageSharp only (the legacy Render result), not ImageSharp.Drawing. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
    <PackageReference Include="JetBrains.Annotations" Version="2026.2.0" PrivateAssets="all" />
  </ItemGroup>
  <!-- The package's icon and readme, packed at its root (NuGet's PackageIcon / PackageReadmeFile). They replace the
       deprecated PackageIconUrl / PackageLicenseUrl, which fail packing as NU5048 / NU5125 where warnings are errors.
       THIRD-PARTY-NOTICES.md goes with them: the packages carry code and data from other projects (Gymnasium's assets,
       Box2D, SDL_gfx, SDL_ttf, CPython, OpenCV, pygame-ce, MuJoCo; each listed there with its notice), and those
       licences ask for their notices in every copy. One file in all five packages, so none ships without a notice it
       needs; the package's own licence stays the Apache-2.0 expression (DR-49). -->
  <ItemGroup>
    <None Include="..\..\eng\icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <!-- Gym.NET's source generator (DR-13, DR-34): the options records of [GymOptions] wrappers and the members of
       [GymTuple]/[GymDict] records. It runs in the compiler only (ReferenceOutputAssembly="false"), and the package carries it
       under analyzers/dotnet/cs so a consumer's own envs and records get it too. -->
  <ItemGroup>
    <ProjectReference Include="..\Gym.SourceGenerators\Gym.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" PrivateAssets="all" />
    <None Include="..\Gym.SourceGenerators\bin\$(Configuration)\netstandard2.0\Gym.SourceGenerators.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>

  <!-- NumSharp.Build, the [NDScoped] IL weaver of decision D19: after compile it wraps each [NDScoped] method's body in an
       NDScope, so a method's temporary arrays are reclaimed while its results (and the INDArrayCarrier results,
       StepResult/ResetResult) survive. A development dependency: PrivateAssets="all" keeps it out of the package's
       dependencies, and it rewrites only this assembly. -p:SkipNDScopeWeave=true builds without weaving. -->
  <ItemGroup>
    <PackageReference Include="NumSharp.Build" Version="0.81.0" PrivateAssets="all" />
  </ItemGroup>

  <!-- NumSharp: the regular NuGet reference, used as it stands by default (NumSharpSource=Package; 0.80.0 is the first
       release with the DType API). -p:NumSharpSource=Submodule makes eng/NumSharp.props swap it for refs/NumSharp's source
       build, with its ownership analyzer, to try a NumSharp fix before NumSharp releases it. The import stays last: it
       removes the reference declared before it and overrides GeneratePackageOnBuild above. -->
  <ItemGroup>
    <PackageReference Include="NumSharp" Version="0.81.0" />
  </ItemGroup>
  <Import Project="..\..\eng\NumSharp.props" />
</Project>
