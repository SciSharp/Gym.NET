<Project Sdk="Microsoft.NET.Sdk">

  <!-- The pygame-compatible rasterizer of the Gymnasium port (port plan section 5.5, workstream F5): a Surface with pygame's
       semantics and the drawing primitives Gymnasium's envs render with, reproduced pixel for pixel. The gfxdraw
       primitives are a C# port of SDL_gfx 2.0.26 (zlib, see SdlGfx/SdlGfxPrimitives.cs and THIRD-PARTY-NOTICES.md). -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Gym.Rendering</RootNamespace>
    <!-- New projects follow the port plan's section 3.7. -->
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageId>Gym.NET.Rendering</PackageId>
    <Version>0.2.0</Version>
    <Authors>Eli Belash</Authors>
    <Company>SciSharp STACK</Company>
    <Product>Gym.NET.Rendering</Product>
    <Description>pygame-compatible software rasterizer for Gym.NET: the Surface, gfxdraw primitives (a C# port of SDL_gfx 2.0.26), transform.flip, surfarray and Vector2.rotate_rad that Gymnasium's environments render with, reproduced pixel for pixel.</Description>
    <Copyright>2023 © SciSharp STACK Team</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/SciSharp/Gym.NET</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/SciSharp/Gym.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>gym, gymnasium, reinforcement learning, rendering, pygame, SDL_gfx, NumSharp</PackageTags>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
  </PropertyGroup>

  <ItemGroup>
    <!-- Gym for the Python built-in semantics the primitives' argument conversion needs (Gym.Utils.PyBuiltins). -->
    <ProjectReference Include="..\Gym\Gym.csproj" />
  </ItemGroup>

  <!-- The package's icon and readme, packed at its root (NuGet's PackageIcon / PackageReadmeFile). They replace the
       deprecated PackageIconUrl / PackageLicenseUrl, which fail packing as NU5048 / NU5125 where warnings are errors. -->
  <ItemGroup>
    <None Include="..\..\eng\icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
  <!-- NumSharp: the regular NuGet reference (surfarray returns NDArrays), used as it stands by default
       (NumSharpSource=Package; 0.80.0 is the first release with the DType API). -p:NumSharpSource=Submodule makes
       eng/NumSharp.props swap it for refs/NumSharp's source build, with its ownership analyzer, to try a NumSharp fix before
       NumSharp releases it. The import stays last: it removes the reference declared before it and overrides
       GeneratePackageOnBuild above. -->
  <ItemGroup>
    <PackageReference Include="NumSharp" Version="0.80.0" />
  </ItemGroup>
  <Import Project="..\..\eng\NumSharp.props" />

</Project>
