<Project Sdk="Microsoft.NET.Sdk">

  <!-- The pygame-compatible rasterizer of the Gymnasium port (port plan section 5.5, workstream F5): a Surface with pygame's
       semantics and the drawing primitives Gymnasium's envs render with, reproduced pixel for pixel. The gfxdraw
       primitives are a C# port of SDL_gfx 2.0.26 (zlib, see SdlGfx/SdlGfxPrimitives.cs and THIRD-PARTY-NOTICES.md).
       draw.aaline/aalines (Draw.Aaline.cs) are translated from pygame-ce 2.5.8's src_c/draw.c (decision DR-37) and keep
       its license, the GNU Library GPL version 2 or later, so the package's license expression names both licenses. -->
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <!-- net11.0 (D24) when the SDK can build it, 11.0.100 and later: an older SDK keeps building the frameworks above
         instead of failing with NETSDK1045, and Directory.Build.targets stops a release build on one. -->
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">$(TargetFrameworks);net11.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Gym.Rendering</RootNamespace>
    <!-- New projects follow the port plan's section 3.7. -->
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageId>Gym.NET.Rendering</PackageId>
    <Version>1.0.0</Version>
    <Authors>Eli Belash</Authors>
    <Company>SciSharp STACK</Company>
    <Product>Gym.NET.Rendering</Product>
    <Description>The software rasterizer Gym.NET's environments draw their rgb_array frames with, pixel for pixel as pygame-ce draws Gymnasium's: a Surface with pygame's semantics, SDL_gfx 2.0.26's gfxdraw primitives in C#, draw.line and draw.rect, draw.aaline and draw.aalines translated from pygame-ce's draw.c, alpha blitting, transform.flip/scale/smoothscale, image loading, surfarray and Vector2.</Description>
    <Copyright>2019-2026 © SciSharp STACK Team</Copyright>
    <!-- The repository's base license, as every Gym.NET package (the maintainer's decision DR-49, which replaced DR-37's
         combined expression on 2026-11-11). Draw.Aaline.cs keeps its source's notice as attribution (THIRD-PARTY-NOTICES.md). -->
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/SciSharp/Gym.NET</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/SciSharp/Gym.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>gym;gymnasium;reinforcement-learning;rendering;rasterizer;pygame;sdl_gfx</PackageTags>
    <PackageReleaseNotes>https://github.com/SciSharp/Gym.NET/blob/master/docs/releases/RELEASE_1.0.0.md</PackageReleaseNotes>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
  </PropertyGroup>

  <ItemGroup>
    <!-- Gym for the Python built-in semantics the primitives' argument conversion needs (Gym.Utils.PyBuiltins). -->
    <ProjectReference Include="..\Gym\Gym.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ImageSharp decodes the PNG assets Image.Load reads (pygame.image.load). Same line as src/Gym: the last Apache-2.0
         release (2.1.x); newer majors ship under the Six Labors Split License and fail Release builds without a key. Its
         advisories are suppressed in Directory.Build.props (D18). Declared here, not only inherited through Gym, because
         this assembly calls it directly. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
  </ItemGroup>

  <!-- The package's icon and readme, packed at its root (NuGet's PackageIcon / PackageReadmeFile). They replace the
       deprecated PackageIconUrl / PackageLicenseUrl, which fail packing as NU5048 / NU5125 where warnings are errors.
       THIRD-PARTY-NOTICES.md goes with them: the packages carry code and data from other projects (Gymnasium's assets,
       Box2D, SDL_gfx, SDL_ttf, CPython, OpenCV, pygame-ce, MuJoCo; each listed there with its notice), and those
       licences ask for their notices in every copy. One file in all five packages, so none ships without a notice it
       needs; the package's own licence stays the Apache-2.0 expression (DR-49). -->
  <ItemGroup>
    <None Include="..\..\eng\icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
  <!-- NumSharp: the regular NuGet reference (surfarray returns NDArrays), used as it stands by default
       (NumSharpSource=Package; 0.80.0 is the first release with the DType API). -p:NumSharpSource=Submodule makes
       eng/NumSharp.props swap it for refs/NumSharp's source build, with its ownership analyzer, to try a NumSharp fix before
       NumSharp releases it. The import stays last: it removes the reference declared before it and overrides
       GeneratePackageOnBuild above. -->
  <ItemGroup>
    <PackageReference Include="NumSharp" Version="0.81.0" />
  </ItemGroup>
  <Import Project="..\..\eng\NumSharp.props" />

</Project>
