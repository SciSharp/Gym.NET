<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <!-- net11.0 (D24) when the SDK can build it, 11.0.100 and later: an older SDK keeps building the frameworks above
         instead of failing with NETSDK1045, and Directory.Build.targets stops a release build on one. -->
    <TargetFrameworks Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '11.0'))">$(TargetFrameworks);net11.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageId>Gym.NET.Rendering.Avalonia</PackageId>
    <!-- Release candidate 1 of 1.0 (decision D25). NuGet ignores the +rc1 build metadata when it matches versions,
         so this is the stable 1.0.0 to every client; the label stays in the package's version and the assemblies'
         informational version. The next release, a fix or the final, is 1.0.1: nuget.org cannot hold a second 1.0.0. -->
    <Version>1.0.0+rc1</Version>
    <Authors>Eli Belash</Authors>
    <Company>SciSharp STACK</Company>
    <Product>Gym.NET.Rendering.Avalonia</Product>
    <Description>A desktop window for Gym.NET's human render mode on Avalonia (Windows, Linux, macOS): set Gymnasium.HumanViewerFactory = AvaloniaEnvViewer.Factory and make an env with render_mode "human". Also PlayPlot's live charts drawn by ScottPlot (AvaloniaPlotFigure.Subplots()).</Description>
    <Copyright>2019-2026 © SciSharp STACK Team</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/SciSharp/Gym.NET</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <!-- No PackageReadmeFile, deliberately: Directory.Build.targets (GYMNET0012) says why and enforces it. -->
    <RepositoryUrl>https://github.com/SciSharp/Gym.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>gym;gymnasium;reinforcement-learning;rendering;avalonia;viewer</PackageTags>
    <PackageReleaseNotes>https://github.com/SciSharp/Gym.NET/blob/master/docs/releases/RELEASE_1.0.0.md</PackageReleaseNotes>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <!-- The XML documentation goes into the package next to the assembly, so consumers' IntelliSense shows Gym.NET's docs
         (P10.4). Members of the pre-1.0 code without docs (Gym.Internal, the 0.2 LunarLander, the viewers' XAML classes)
         raise CS1591 warnings, which the build tolerates (DR-05). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <ApplicationIcon />
    <StartupObject />
    <!-- Avalonia 11+ source-generates a partial class (InitializeComponent + named-element fields) for every x:Class
         XAML. The code-behind here is hand-written, non-partial and calls AvaloniaXamlLoader.Load itself (the Avalonia
         0.10 model), so the generated half would collide with it (CS0260). The XAML is still compiled. -->
    <AvaloniaNameGeneratorIsEnabled>false</AvaloniaNameGeneratorIsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <Compile Update="**\*.xaml.cs">
      <DependentUpon>%(Filename)</DependentUpon>
    </Compile>
    <!-- Avalonia 11+ compiles only AvaloniaXaml items, and its default glob covers *.axaml, not *.xaml. Declaring the
         .xaml files as AvaloniaXaml keeps them compiled (AvaloniaXamlLoader.Load needs precompiled XAML at runtime);
         as AvaloniaResource they would only be embedded, and the viewer would fail to load. -->
    <AvaloniaXaml Include="**\*.xaml">
      <SubType>Designer</SubType>
    </AvaloniaXaml>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <!-- Since Avalonia 11 the built-in "Default" theme ships separately as SimpleTheme; without a theme
         a Window has no control template and renders nothing, so the viewer would stay blank. -->
    <PackageReference Include="Avalonia.Themes.Simple" Version="12.1.3" />
    <!-- Last Apache-2.0 ImageSharp line; 3.x+ is Split-licensed and fails Release builds without a Six Labors key. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
    <!-- PlayPlot's chart backend in this package (DR-39): ScottPlot's Avalonia control (MIT), built for Avalonia 12.
         The core package stays free of chart dependencies. -->
    <PackageReference Include="ScottPlot.Avalonia" Version="5.1.59" />
  </ItemGroup>
  <ItemGroup>
    <!-- The ScottPlot axes adapter both viewer packages compile, so their figures draw alike (DR-39). -->
    <Compile Include="..\Shared\ScottPlotAxes.cs" Link="Plotting\ScottPlotAxes.cs" />
    <!-- The (H, W, 3) frame conversion both viewers share (DR-85): compiled into each, like the axes above. -->
    <Compile Include="..\Shared\ViewerFrames.cs" Link="Rendering\ViewerFrames.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Gym.Environments\Gym.Environments.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="App.xaml">
      <Generator>MSBuild:Compile</Generator>
    </None>
    <None Update="AvaloniaEnvViewer.xaml">
      <Generator>MSBuild:Compile</Generator>
    </None>
  </ItemGroup>
  <!-- The package's icon, packed at its root (NuGet's PackageIcon), replaces the deprecated PackageIconUrl, as
       PackageLicenseExpression replaces PackageLicenseUrl: both deprecated properties fail packing as NU5048 / NU5125 where
       warnings are errors. No readme is packed (Directory.Build.targets, GYMNET0012).
       THIRD-PARTY-NOTICES.md goes with the icon: the packages carry code and data from other projects (Gymnasium's assets,
       Box2D, SDL_gfx, SDL_ttf, CPython, OpenCV, pygame-ce, MuJoCo; each listed there with its notice), and those
       licences ask for their notices in every copy. One file in all five packages, so none ships without a notice it
       needs; the package's own licence stays the Apache-2.0 expression (DR-49). -->
  <ItemGroup>
    <None Include="..\..\eng\icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
