<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
    <PackageId>Gym.NET.Rendering.Avalonia</PackageId>
    <Version>2.0.0</Version>
    <Authors>Eli Belash</Authors>
    <Company>SciSharp STACK</Company>
    <Product>Gym.NET.Rendering.Avalonia</Product>
    <Description>A desktop window for Gym.NET's human render mode on Avalonia (Windows, Linux, macOS): set Gymnasium.HumanViewerFactory = AvaloniaEnvViewer.Factory and make an env with render_mode "human".</Description>
    <Copyright>2019-2026 © SciSharp STACK Team</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/SciSharp/Gym.NET</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/SciSharp/Gym.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>gym;gymnasium;reinforcement-learning;rendering;avalonia;viewer</PackageTags>
    <PackageReleaseNotes>https://github.com/SciSharp/Gym.NET/blob/master/docs/releases/RELEASE_2.0.0.md</PackageReleaseNotes>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    <!-- The XML documentation goes into the package next to the assembly, so consumers' IntelliSense shows Gym.NET's docs
         (P10.4). Members of the pre-2.0 code without docs (Gym.Internal, the 0.2 LunarLander, the viewers' XAML classes)
         raise CS1591 warnings, which the build tolerates (DR-05). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AssemblyVersion>2.0.0.0</AssemblyVersion>
    <FileVersion>2.0.0.0</FileVersion>
    <ApplicationIcon />
    <StartupObject />
    <!-- Avalonia 11+ source-generates a partial class (InitializeComponent + named-element fields) for every x:Class
         XAML. The code-behind here is hand-written, non-partial and calls AvaloniaXamlLoader.Load itself (the Avalonia
         0.10 model), so the generated half would collide with it (CS0260). The XAML is still compiled. -->
    <AvaloniaNameGeneratorIsEnabled>false</AvaloniaNameGeneratorIsEnabled>
  </PropertyGroup>
  <ItemGroup>
    <Compile Update="**\*.xaml.cs">
      <DependentUpon>%(Filename)</DependentUpon>
    </Compile>
    <!-- Avalonia 11+ compiles only AvaloniaXaml items, and its default glob covers *.axaml, not *.xaml. Declaring the
         .xaml files as AvaloniaXaml keeps them compiled (AvaloniaXamlLoader.Load needs precompiled XAML at runtime);
         as AvaloniaResource they would only be embedded, and the viewer would fail to load. -->
    <AvaloniaXaml Include="**\*.xaml">
      <SubType>Designer</SubType>
    </AvaloniaXaml>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.3" />
    <!-- Since Avalonia 11 the built-in "Default" theme ships separately as SimpleTheme; without a theme
         a Window has no control template and renders nothing, so the viewer would stay blank. -->
    <PackageReference Include="Avalonia.Themes.Simple" Version="12.1.3" />
    <!-- Last Apache-2.0 ImageSharp line; 3.x+ is Split-licensed and fails Release builds without a Six Labors key. -->
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Gym.Environments\Gym.Environments.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="App.xaml">
      <Generator>MSBuild:Compile</Generator>
    </None>
    <None Update="AvaloniaEnvViewer.xaml">
      <Generator>MSBuild:Compile</Generator>
    </None>
  </ItemGroup>
  <!-- The package's icon and readme, packed at its root (NuGet's PackageIcon / PackageReadmeFile). They replace the
       deprecated PackageIconUrl / PackageLicenseUrl, which fail packing as NU5048 / NU5125 where warnings are errors. -->
  <ItemGroup>
    <None Include="..\..\eng\icon.png" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

</Project>
